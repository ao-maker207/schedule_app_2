<div class="form-wrapper">
  <div class="card-box">

    <%= form_with(model: schedule, local: true) do |form| %>
      
      <div class="form-group">
        <%= form.label :title do %>
          タイトル <span style="color: red;">*</span>
        <% end %>
        <%= form.text_field :title, placeholder: "タイトル(20文字以内)", class: "form-control" %>
      </div>

      <div class="form-row">
        <div class="form-group flex-1">
          <%= form.label :start_date do %>
            開始日 <span style="color: red;">*</span>
          <% end %>
          <%= form.date_field :start_date, class: "form-control" %>
        </div>

        <div class="form-group flex-1" style="margin-left: 20px;">
          <%= form.label :end_date do %>
            終了日 <span style="color: red;">*</span>
          <% end %>
          <%= form.date_field :end_date, class: "form-control" %>
        </div>
      </div>

      <div class="form-group checkbox-group">
        <%= form.check_box :is_all_day %>
        <%= form.label :is_all_day, "終日の場合はチェックを入れます" %>
      </div>

      <div class="form-group">
        <%= form.label :memo, "スケジュールメモ" %>
        <%= form.text_area :memo, placeholder: "メモを入力する(500文字以内)", rows: 5, class: "form-control" %>
      </div>

      <div style="display: flex; justify-content: flex-end; gap: 15px; margin-top: 20px;">
        <%= link_to "キャンセル", schedules_path, class: "btn-cancel" %>
        <%= form.submit "保存", class: "btn-primary" %>
      </div>

    <% end %>

  </div>
</div>