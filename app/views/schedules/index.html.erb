<div class="index-container">

  <div class="header-container">
    <h1>予定一覧</h1>
    <%= link_to "⊕ 新規追加", new_schedule_path, class: "btn-primary" %>
  </div>

  <div class="card-box">
    <table class="schedule-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>タイトル</th>
          <th>開始日</th>
          <th>終了日</th>
          <th>終日</th>
          <th>更新日時</th>
          <th colspan="3"></th>
        </tr>
      </thead>

      <tbody>
        <% @schedules.each do |schedule| %>
          <tr>
            <td><%= schedule.id %></td>
            <td style="font-weight: 500;"><%= schedule.title %></td>
            <td><%= schedule.start_date&.strftime("%Y/%m/%d") %></td>
            <td><%= schedule.end_date&.strftime("%Y/%m/%d") %></td>
            <td style="text-align: center;"><%= schedule.is_all_day ? "○" : "" %></td>
            <td><%= schedule.updated_at.strftime("%Y/%m/%d %H:%M") %></td>
            <td><%= link_to "詳細", schedule, class: "link-action" %></td>
            <td><%= link_to "編集", edit_schedule_path(schedule), class: "link-action" %></td>
            <td>
            <%= button_to "削除", schedule, 
              method: :delete, onclick: "return confirm('予定を削除しますか？');", class: "btn-delete-fallback" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="card-box footer-info">
    <div>予定合計 <span style="font-size: 24px; font-weight: bold; margin: 0 5px;"><%= @schedules.count %></span> 件</div>
    <div style="color: #6c757d;">本日の日付 <%= Date.today.strftime("%Y/%m/%d") %></div>
  </div>
</div>